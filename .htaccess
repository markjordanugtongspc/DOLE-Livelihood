# Disable directory browsing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden files and directories (starting with a dot)
    RewriteRule (^|/)\.(?!well-known/) - [F]

    # Route /api/* to backend API front controller (must be before backend blocking)
    RewriteRule ^api(/.*)?$ backend/api/index.php [QSA,L]

    # Block direct access to sensitive directories (except backend/api)
    RewriteRule ^(config|database|storage|tests|scripts) - [F,L]
    RewriteRule ^backend/(?!api) - [F,L]

    # Route /dashboard/ to frontend dashboard page
    RewriteRule ^dashboard/?$ frontend/pages/dashboard/index.php [QSA,L]

    # Default fallback to index.php
    RewriteRule ^$ index.php [L]
</IfModule>
